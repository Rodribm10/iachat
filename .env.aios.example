# ============================================
# Synkra AIOS — variáveis de FERRAMENTA DE DESENVOLVIMENTO
# ============================================
# Nada aqui é lido pelo app Chatwoot. São credenciais das ferramentas de
# desenvolvimento (agentes, MCPs, CI). Foram separadas do .env.example em
# 22/08/2026 porque o instalador do AIOS havia sobrescrito o .env.example do
# Chatwoot inteiro, apagando SECRET_KEY_BASE, REDIS_URL, POSTGRES_HOST e o
# resto da configuração real da aplicação.
#
# Copie para .env.aios e preencha. NÃO commite com credencial real.
# ============================================

# --- LLM providers das ferramentas ----------
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- Busca e pesquisa -----------------------
EXA_API_KEY=
CONTEXT7_API_KEY=

# --- Supabase das ferramentas ---------------
# (o Supabase que o APP usa é RESERVA_1001_SUPABASE_*, no .env.example)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Versionamento e CI ---------------------
GITHUB_TOKEN=

# --- Gestão de projeto ----------------------
CLICKUP_API_KEY=

# --- Automação ------------------------------
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --- Cloud providers ------------------------
RAILWAY_TOKEN=
VERCEL_TOKEN=

# --- AIOS core ------------------------------
NODE_ENV=development
AIOS_VERSION=2.2.0
